
# ─────────────────────────────
# SERVER CONFIG
# ─────────────────────────────
#PORT=5000
#NODE_ENV=development

# ─────────────────────────────
# DATABASE (MongoDB)
# ─────────────────────────────
#MONGODB_URI=mongodb://127.0.0.1:27017/mood-detector

# ─────────────────────────────
# FRONTEND URL (React Vite)
# ─────────────────────────────
#FRONTEND_URL=http://localhost:5173

# ─────────────────────────────
# SECURITY (optional nanti)
# ─────────────────────────────
#JWT_SECRET=supersecretkey
#JWT_EXPIRES_IN=7d

# ─────────────────────────────
# UPLOAD CONFIG (kalau pakai multer)
# ─────────────────────────────
#MAX_FILE_SIZE=5242880
#UPLOAD_DIR=uploads

# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ────────────────────────────────────
# 1. Buka https://cloud.mongodb.com → buat akun gratis
# 2. Buat cluster M0 Free → buat user → allow all IPs (0.0.0.0/0)
# 3. Connect → Drivers → salin connection string
# 4. Ganti <username> <password> dan tambah /mood-detector sebelum ?
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mood-detector?retryWrites=true&w=majority

# ── JWT Secret ───────────────────────────────────────
# Buat string acak panjang, bisa pakai: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_string_rahasia_panjang_minimal_32_karakter
JWT_EXPIRES_IN=7d

# ── Frontend URL (CORS) ──────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── AI Services ──────────────────────────────
AI_SERVICE_URL=http://localhost:8000
